# Xiaomi Redmi 5 (rosy)
CONFIG_MACH_XIAOMI_MSM8953=y
CONFIG_MACH_XIAOMI_ROSY=y
# CONFIG_MACH_XIAOMI_VINCE is not set
# CONFIG_MACH_XIAOMI_DAISY is not set
# CONFIG_MACH_XIAOMI_TISSOT is not set
# CONFIG_MACH_XIAOMI_TIFFANY is not set
# CONFIG_MACH_XIAOMI_MIDO is not set
# CONFIG_MACH_XIAOMI_MARKW is not set
# CONFIG_MACH_XIAOMI_YSL is not set

# Build exactly the DTB used by rosy.  This is a non-A/B legacy boot image.
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="vendor/qcom/rosy-titanium"

# Rosy defines nine reusable shared-dma-pool regions.  CMA supports one
# implicit area in addition to this value, so eight configured areas are
# required for all of the device's pools to initialize.
CONFIG_CMA_AREAS=8

# Rosy uses the M-generation legacy camera stack.
CONFIG_MSMB_CAMERA_LEGACY=y
# CONFIG_MSMB_CAMERA_LEGACY_N is not set

# This live unit uses the Goodix GF3208.  FPC1020 shares its GPIOs and must not
# probe on this handset.
# CONFIG_FINGERPRINT_FPC1020_ROSY is not set
CONFIG_FINGERPRINT_GF3208_ROSY=y
# CONFIG_FINGERPRINT_FPC1020 is not set
# CONFIG_FINGERPRINT_FPC is not set
# CONFIG_FINGERPRINT_GOODIX_GF3208 is not set
# CONFIG_GOODIX_FINGERPRINT is not set
# CONFIG_FINGERPRINT_GOODIX_GF3208_VINCE is not set

# Infrared transmitter is exposed directly to userspace as /dev/spidev6.1.
CONFIG_SPI_SPIDEV=y
# CONFIG_SPI_PEELIR is not set
# CONFIG_RC_CORE is not set
# CONFIG_IR_PWM_MI8953 is not set

# LEDs and haptics.
CONFIG_LEDS_AW2013_MI8953=y
CONFIG_LEDS_QPNP=y
CONFIG_LEDS_QPNP_WLED=y
CONFIG_LEDS_QPNP_HAPTICS=y

# Trial96 uses the generic EDT FocalTech path for Rosy's FT8716.  Do not build
# the Xiaomi vendor FTS stack at the same time; it carries private sysfs/pinctrl
# behavior and can contend for the same GPIO/I2C resources.
# CONFIG_TOUCHSCREEN_SYSCTL_MI8953 is not set
# CONFIG_TOUCHSCREEN_FTS_MI8953 is not set
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
# CONFIG_TOUCHSCREEN_DOUBLETAP2WAKE is not set
# CONFIG_TOUCHSCREEN_SWEEP2WAKE is not set
# CONFIG_TOUCHSCREEN_GT9XX is not set
# CONFIG_TOUCHSCREEN_TD4310_E7 is not set
# CONFIG_TOUCHSCREEN_TD4310_LANSI_E7 is not set
# CONFIG_TOUCHSCREEN_NT36XXX is not set
# CONFIG_TOUCHSCREEN_NT36XXX_I2C is not set
# CONFIG_TOUCHSCREEN_IST3038C is not set

# TAS2557 belongs to other msm8953-family devices; rosy uses AW87319.
# CONFIG_SND_SOC_TAS2557 is not set
# CONFIG_TAS2557_REGMAP is not set
# CONFIG_TAS2557_CODEC is not set
# CONFIG_TAS2557_MISC is not set

# ROM/storage compatibility.
CONFIG_SYSTEM_TRUSTED_KEYS="verity.x509.pem"
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_LINEAR=y
# CONFIG_DM_DEFAULT_KEY is not set
CONFIG_DM_ANDROID_VERITY=y
CONFIG_MODULE_FORCE_UNLOAD=y

# This ROM was booting a 4.9 kernel and uses the classic binder devices rather
# than mounting binderfs.  Keep the names expected by servicemanager and
# vndservicemanager.
# CONFIG_ANDROID_BINDERFS is not set
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Existing userdata uses Qualcomm's v1 private/ICE policy.  Reproduce the
# nonce-derived 4.9 PFK keys when the filesystem is mounted with inlinecrypt.
CONFIG_ENABLE_LEGACY_PFK=y
# Software blk-crypto fallback cannot reproduce legacy ext4's physical
# 512-byte request-sector DUN and must never be used for this device.
# CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK is not set

# Rosy uses the downstream legacy DWC3 glue.
CONFIG_USB_DWC3_MSM_LEGACY=y
